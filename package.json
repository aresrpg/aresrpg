{
  "name": "aresrpg",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "ares": "node scripts/ares.mjs",
    "dev:frontend": "cd packages/frontend && bun run dev",
    "dev": "bun run dev:frontend",
    "lint": "NODE_OPTIONS=--max-old-space-size=6144 eslint . --max-warnings 2888 && prettier . --check && bun scripts/check-doc-file-references.mjs && bun run --cwd packages/sim lint && bash scripts/check-constraints.sh",
    "check:constraints": "bash scripts/check-constraints.sh",
    "check:move-locks": "node packages/move/scripts/check_move_lock_revs.mjs",
    "typecheck": "bun run --cwd packages/engine typecheck && bun run --cwd packages/sdk typecheck && bun run --cwd packages/sim typecheck && bun run --cwd packages/frontend typecheck",
    "format": "prettier . --write && eslint . --fix",
    "release:prepare": "bun run --cwd packages/move release:prepare",
    "test": "bun run --filter '*' test",
    "test:order-independence": "bash scripts/order-independence-gate.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^25.9.5",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-functional": "^10.0.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  },
  "overrides": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@mysten/sui": "2.20.1"
  },
  "license": "SEE LICENSE IN LICENSE"
}
