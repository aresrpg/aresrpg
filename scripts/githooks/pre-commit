#!/bin/sh
# Fast staged-file style checks. Full repository verification belongs to CI.
set -e
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0
# Style tools check source files, not symlinks to their canonical assets.
style_files=$(printf '%s\n' "$staged" | while IFS= read -r path; do
  [ -L "$path" ] || printf '%s\n' "$path"
done)
js=$(printf '%s\n' "$style_files" | grep -E '\.(js|mjs|cjs|jsx|ts|tsx)$' || true)
if [ -n "$js" ]; then printf '%s\n' "$js" | xargs bunx eslint; fi
if [ -n "$style_files" ]; then printf '%s\n' "$style_files" | xargs bunx prettier --check --ignore-unknown; fi
