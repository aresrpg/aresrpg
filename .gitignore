# dev-only keypairs (funded test identities) — NEVER commit (devops 2026-06-28)
.dev/

# MCP server configs commonly carry bearer tokens — a future `git add -A` must never commit one
.mcp.json

# Playwright/test artifacts + scratch scripts — staged-junk guard.
test-results/
coverage/
scratch_*.mjs
*.last-run.json

packages/engine/bench/artifacts/
.claude/settings.local.json

# Local worktrees (agent-created or manual) — a directory-copy fork would carry these nested
# checkouts whole, so the pattern belongs in the committed .gitignore as defense in depth.
**/[.]claude/worktrees/

# agent working areas — never committed
scratchpad/
work/

# Move coverage/trace artifacts (regenerated by every `sui move test --coverage` run)
packages/*/traces/
packages/*/.coverage_map.mvcov

vfx
