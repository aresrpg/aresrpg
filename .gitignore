node_modules
bun.lockb

# The pre-rewrite app — kept on disk as the extraction reference until the purge completes,
# no longer part of the repo.
deprecated/

dist/
build/

.env
.env.*
!.env.example

*.log
logs/

.DS_Store
.idea/
.vscode/
.playwright-mcp

packages/sdk/types/
.vercel

# dev-only keypairs (funded test identities) — NEVER commit (devops 2026-06-28)
.dev/

# MCP server configs commonly carry bearer tokens — a future `git add -A` must never commit one
.mcp.json

# Licensed commercial tracks (the hack-radio set) — the repo is PUBLIC; these are masters we may
# play, never distribute. The biome soundtracks beside them ARE tracked (owner 2026-08-12).
music/hack_radio/

# Playwright/test artifacts + scratch scripts — staged-junk guard.
test-results/
coverage/
scratch_*.mjs
*.last-run.json

packages/engine/bench/artifacts/
.claude/settings.local.json

# Local worktrees (agent-created or manual) — a directory-copy fork would carry these nested
# checkouts whole, so the pattern belongs in the committed .gitignore as defense in depth.
**/[.]claude/worktrees/

# agent working areas — never committed
scratchpa[d]/
packages/engine/scratchpa[d]/biomes/refs_video/

# Move coverage/trace artifacts (regenerated by every `sui move test --coverage` run)
packages/control/traces/
packages/seed/traces/
packages/move-math/traces/
packages/move/traces/
packages/*/.coverage_map.mvcov

# a symlinked node_modules slips past the directory-only rule above and dangles elsewhere
packages/move/node_modules
vfx/**.zip
