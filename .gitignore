# S-72 research corpus: raw 1.29 donor dumps (huge + brand-laden by nature; rebuildable via

*.log
logs/

.DS_Store
.idea/
.vscode/
.playwright-mcp

packages/shared/src/generated/
packages/sdk/types/
votifier-keys/
.vercel
aresrpg-assets-backup-*
seed/.prod-snapshot/
seed/.migration_plan_*.json
seed/.migration_result_*.json
seed/.pre-migration-*/

# dev-only keypairs (funded test identities) — NEVER commit (devops 2026-06-28)
.dev/

# MCP server configs commonly carry bearer tokens — none exists in the tree today, but a future
# `git add -A` must never be able to commit one (S-22 audit preventive note, 2026-07-09).
.mcp.json

# Real asset library (69 GLBs ~30M) — private seed-repo content, hosted in object storage,
# never committed here. Publishing and the model corpus are the seed repo's act (owner ruling,
# 2026-07-23) — the one sanctioned exception is the fight-start ceremony sword, tracked at
# packages/frontend/public/sprites/misc/fight_sword.glb (D280).
models/

# Raw biome soundtracks (~36M) — served from object storage, not git
music/

# Purchased VFX pack zips (licensed source; effects ported to code — packs are masters only, never distributed)
vfx/

# Rendered mob encyclopedia icons (thumb + _hd pair per GLB, scripts/render_mob_icons.mjs) — regenerable
# from public/sprites/mobs/models; ships via the asset host (the seed repo's publish pipeline), not git.
packages/frontend/public/sprites/mobs/icons/

# Playwright/test artifacts + scratch scripts — staged-junk guard (qa-code audit 2026-07-02).
# These leaked into the index once (test-results/**/trace.zip, scratch_b7_settle.mjs); ignore them
# so they can never re-enter the tree. Applies at any depth (e.g. packages/frontend/test-results/).
test-results/
scratch_*.mjs
*.last-run.json

# ── Backend archived — this branch is on-chain ──
# Backend runtime moved out of the tracked tree into /archive/ (local-only backup).
# /archive/ is untracked; the patterns below stop any backend from re-entering the tree.
/archive/
/packages/backend/
/packages/worker/
/packages/server/
/packages/indexer/
/Dockerfile
/Dockerfile.worker
packages/engine/bench/artifacts/
.claude/settings.local.json

# Local worktrees (agent-created or manual) — already excluded via .git/info/exclude, but that's
# LOCAL only. A directory-copy fork (not a git clone) would carry these nested checkouts whole,
# so the pattern belongs in the committed .gitignore too as defense in depth (S-22 audit, 2026-07-09).
**/[.]claude/worktrees/

# agent working areas — never committed
scratchpa[d]/
packages/engine/scratchpa[d]/biomes/refs_video/

# transient per-lane scratch reports (docs/tmp_lane_*.md et al) — agent working notes, never tracked
docs/tmp_*

# Move coverage/trace artifacts (~75M+/pkg, regenerated by every `sui move test` coverage run —
# the coverage GATE is tracked, its exhaust isn't)
packages/move/*/traces/

# Purchased BinbunVFX packs — porting SOURCE only (runtime uses the JS/TSL ports in
# packages/engine/src/render). Kept LOCAL, never tracked; the reduction
# /ship untracks the dir via `git rm -r --cached vfx/`.
/vfx/

# L1 oracle shrink artifacts (issue #930): the minimal failing capsule a failing property stream
# dumps for local forensics. The landed record of a confirmed defect is its GitHub issue + the
# quarantine row, never a committed blob.
packages/*/test/oracle/artifacts-local/

# driven-harness run artifacts (boot/encyclopedia smoke, the fight bot sheet) — outputs, never sources
smoke-out/

# a symlinked node_modules slips past the directory-only rule above and dangles elsewhere
packages/move/node_modules

# the upgrade ceremony's resume journal — per-run state that survives a halt, never a source
packages/move/scripts/out/ceremony_upgrade_pending.json
