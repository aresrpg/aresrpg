# AresRPG — environment variables (names only; NEVER commit real values).
# Single `.env` at the project root; the frontend reads VITE_* via Vite (envDir '../../').
# Every VITE_* has a working default in packages/frontend/src/env.ts, so a bare boot never throws.
#
# ⚠️ NO PRIVATE KEYS IN ANY LOCAL ENV FILE, EVER. The local sponsor is retired;
# dev/QA signing keys are injected ad-hoc per run (devnet-contained tests only), e.g.
#   VITE_DEV_KEY=suiprivkey... bun run test:e2e
# Production/server config (SPONSOR_*, GAS_STATION_*, GAS_POOL_*) lives EXCLUSIVELY in deployment env
# (Vercel dashboard / k8s SOPS secrets) — see api/sponsor.mjs + packages/rpc for the consumed names.
# Local env files also never reach a Vercel build: .vercelignore excludes .env* and the buildCommand
# rm's them (2026-07-14 leak fix; packages/frontend/scripts/assert_clean_bundle.mjs gates the bundle).

# ── Sponsor → internal Mysten gas station (server only; never VITE/browser) ──
# Station service base URL; sponsor appends /v1/reserve_gas and /v1/execute_tx.
GAS_STATION_URL=
# Shared bearer: the sponsor and gas-station workloads must receive the same secret.
GAS_STATION_AUTH=
# Sentry error reporting for api/sponsor.mjs (errors-only, api/report.js — same shape as the
# frontend's VITE_SENTRY_DSN below, minus the VITE_ prefix since this is never bundled to the
# browser). Empty = reporting fully off (dev default; the org's "sponsor" Sentry project's DSN
# is injected server-side at deploy time — Vercel dashboard / k8s SOPS secret — never here).
SENTRY_DSN=

# ── Frontend (Vite) ─────────────────────────────────────────────────
# testnet | mainnet — chain label (frontend, sponsor, explorer links)
VITE_NETWORK=
# RPC read-API base — the `/v1` read layer (packages/rpc/api). Optional; defaults to http://localhost:3000
# in `vite dev`, or the live testnet read-API (https://rpc.aresrpg.world) in any BUILT bundle — set this
# explicitly for a preview/production deploy that must point elsewhere.
VITE_RPC_URL=
# Sponsor endpoint for zkLogin AresRPG transactions. Optional; defaults to /api/sponsor
VITE_SPONSOR_URL=

# P2P SIGNALING RELAY — OUR self-hosted MQTT broker, the only place browsers meet to exchange WebRTC offers
# (docs/REALTIME.md lane 2). Never a third-party relay and never a list: one URL, no fallback. Optional;
# defaults to wss://relay.aresrpg.world/mqtt in a build, or ws://localhost:9001/mqtt in `vite dev` — point the
# latter at a port-forward of the in-cluster broker (kubectl port-forward svc/mqtt-relay 9001:9001).
VITE_RELAY_URL=
# NAT traversal rides public STUN by default (Google primary, Cloudflare second); VITE_STUN_URL replaces both.
# TURN remains opt-in through VITE_TURN_URL.
VITE_STUN_URL=
VITE_TURN_URL=
VITE_TURN_USER=
VITE_TURN_CRED=
# Retired compatibility name; the frontend deliberately ignores it. Local fallbacks stay at /assets and every
# published asset class takes its remote base from /asset_manifest.json.
VITE_ASSETS_URL=
# Full asset-manifest URL. Optional; defaults to /asset_manifest.json at the web root.
# The deployed file is packages/frontend/public/asset_manifest.json; it declares the asset host and
# which classes are published, and is copied to the web root by the frontend build.
VITE_ASSETS_MANIFEST_URL=
# Sentry error reporting (errors-only, core/report.js). Empty = reporting fully off (dev default)
VITE_SENTRY_DSN=
