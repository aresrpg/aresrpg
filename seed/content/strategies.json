{
  "profile": {
    "version": "1",
    "intent": "Boost first: cast every boost of the hero that is not in effect yet, glyphs at its feet included. Then hit with the most damaging weapon strike or spell as often as the turn allows, moving for damage. With nothing hit, walk closer and hit from there. End the turn when no action is legal.",
    "combos": [
      {
        "name": "attack",
        "steps": [
          {
            "type": "attack",
            "target": "highest_damage_enemy",
            "position": "best_damage",
            "repeat": true
          }
        ]
      },
      {
        "name": "approach",
        "steps": [
          {
            "type": "move",
            "direction": "approach"
          }
        ]
      },
      {
        "name": "boost",
        "steps": [
          {
            "type": "boost"
          }
        ]
      }
    ],
    "rules": [
      {
        "when": {
          "type": "always"
        },
        "combo": "boost"
      },
      {
        "when": {
          "type": "always"
        },
        "combo": "attack"
      },
      {
        "when": {
          "type": "no_hit_yet"
        },
        "combo": "approach"
      },
      {
        "when": {
          "type": "always"
        },
        "combo": "attack"
      }
    ],
    "fallback": "end_turn"
  },
  "difficulty": {
    "easy": {
      "min_size": 1,
      "max_size": 2
    },
    "medium": {
      "min_size": 2,
      "max_size": 4
    },
    "hard": {
      "min_size": 6,
      "max_size": 6
    }
  },
  "strategies": [
    {
      "id": "fight_nearby",
      "defaults": {
        "min_size": 1,
        "max_size": 1
      },
      "tree": {
        "type": "loop",
        "child": {
          "type": "selector",
          "children": [
            {
              "type": "sequence",
              "children": [
                {
                  "type": "condition",
                  "condition": {
                    "fact": {
                      "type": "fight",
                      "character_id": "$character"
                    },
                    "op": "eq",
                    "value": true
                  }
                },
                {
                  "type": "condition",
                  "condition": {
                    "fact": {
                      "type": "fight_minutes",
                      "character_id": "$character"
                    },
                    "op": "gte",
                    "value": 15
                  }
                },
                {
                  "type": "action",
                  "action": {
                    "type": "call",
                    "kind": "fight_forfeit",
                    "payload": {
                      "character_id": "$character"
                    }
                  }
                }
              ]
            },
            {
              "type": "action",
              "action": {
                "type": "combat",
                "target_options": {
                  "min_size": "$min_size",
                  "max_size": "$max_size",
                  "mob_types": "$mob_types",
                  "area": "$area"
                },
                "profiles": [
                  {
                    "character_id": "$character",
                    "profile": "$profile"
                  }
                ]
              }
            },
            {
              "type": "sequence",
              "children": [
                {
                  "type": "condition",
                  "condition": {
                    "type": "fees_spent",
                    "op": "gte",
                    "value": "$fee_cap_mist"
                  }
                },
                {
                  "type": "condition",
                  "condition": {
                    "fact": {
                      "type": "fight",
                      "character_id": "$character"
                    },
                    "op": "eq",
                    "value": false
                  }
                },
                {
                  "type": "complete",
                  "reason": "fee_cap_reached"
                }
              ]
            },
            {
              "type": "sequence",
              "children": [
                {
                  "type": "condition",
                  "condition": {
                    "fact": {
                      "type": "fight",
                      "character_id": "$character"
                    },
                    "op": "eq",
                    "value": false
                  }
                },
                {
                  "type": "condition",
                  "condition": {
                    "fact": {
                      "type": "hp_percent",
                      "character_id": "$character"
                    },
                    "op": "lt",
                    "value": 100
                  }
                },
                {
                  "type": "wait"
                }
              ]
            },
            {
              "type": "action",
              "action": {
                "type": "engage",
                "character_id": "$character",
                "mob_types": "$mob_types",
                "order": "nearest",
                "target_options": {
                  "min_size": "$min_size",
                  "max_size": "$max_size",
                  "mob_types": "$mob_types",
                  "area": "$area"
                }
              }
            },
            {
              "type": "action",
              "action": {
                "type": "discover",
                "character_id": "$character",
                "world": "$world",
                "area": "$area",
                "order": "toward"
              }
            },
            {
              "type": "action",
              "action": {
                "type": "discover",
                "character_id": "$character",
                "world": "$world",
                "area": "$area",
                "order": "nearest"
              }
            }
          ]
        }
      }
    },
