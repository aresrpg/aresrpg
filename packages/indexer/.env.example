# Chain projectionist (src/main.rs clap args are the validator; dotenvy loads this dir's .env).
# Required: the game package lineage.
PACKAGE_ORIGINAL=
PACKAGE_LATEST=
SEED_PACKAGE_ORIGINAL=
# Optional overrides (defaults live beside their args in main.rs).
REMOTE_STORE_URL=https://checkpoints.testnet.sui.io
REDIS_URL=redis://127.0.0.1:6379
GRAPHQL_URL=https://graphql.testnet.sui.io/graphql
# FIRST_CHECKPOINT=            # fresh pipelines only — ignored once a watermark exists
# INGEST_MAX_CONCURRENCY=16    # ceiling against the shared public checkpoint bucket
