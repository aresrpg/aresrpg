# Frontend public configuration (VITE_* only — bundled into the served app; never a secret).
VITE_APP_URL=https://aresrpg.world/
VITE_NETWORK=mainnet
VITE_GRAPHQL_URL=https://graphql.mainnet.sui.io/graphql
VITE_SUI_RPC_URL=https://fullnode.mainnet.sui.io:443
VITE_SERVER_WS_URL=ws://localhost:9800/
VITE_ENGINE_QUALITY=medium
VITE_ENOKI_API_KEY=
# Server-only gift sponsorship. Never use a VITE_ prefix for the private key.
GIFT_SPONSOR_PRIVATE_KEY=
VITE_GOOGLE_CLIENT_ID=
# Public Sentry ingestion DSN; required on Vercel production and preview deployments.
VITE_SENTRY_DSN=

# Optional external EVM/Solana wallet connector; never used for game authentication.
VITE_PRIVY_APP_ID=

# Optional hosted bot MCP service: a public HTTPS origin, without path, credentials or query.
# Empty disables hosted onboarding while existing Inventory/Recall recovery stays available.
VITE_BOT_SERVICE_URL=
# LIVE DEPLOYMENT GATE: add this exact configured origin to connect-src in vercel.json
# before live OAuth/MCP testing. CSP is static; setting this variable does not update it.
# Do not broaden connect-src to https: or a wildcard, or invent a production hostname.
