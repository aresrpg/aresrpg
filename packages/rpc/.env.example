# AresRPG RPC — environment. Copy to `.env` (gitignored) and adjust.
# Every value has a safe default in docker-compose.yml; a bare `docker compose up`
# indexes Sui testnet and serves reads with none of these set.

# --- shared -------------------------------------------------------------------
# Chain label stamped onto indexed records ("testnet" | "mainnet").
NETWORK=testnet

# --- redis --------------------------------------------------------------------
# Host port the redis:8 store is published on. docker-compose.yml binds it to
# 127.0.0.1 only — redis carries no auth. Reaching it from beyond localhost
# requires adding `--requirepass <secret>` to the redis `command` in
# docker-compose.yml (and updating every REDIS_URL / GAS_POOL_REDIS_URL to match).
REDIS_PORT=6379

# --- indexer ------------------------------------------------------------------
# HTTP checkpoint store (reliable backfill + polling source). Watermark advances
# from this alone.
REMOTE_STORE_URL=https://checkpoints.testnet.sui.io
# Optional gRPC live-streaming primary. Leave empty for remote-store polling only.
# Verified working against the public testnet fullnode:
# STREAMING_URL=https://fullnode.testnet.sui.io:443
STREAMING_URL=
# Start checkpoint for a fresh index (no watermark yet). EMPTY = genesis backfill.
# For a live-from-the-tip demo, set this to a recent testnet checkpoint, e.g.
# fetch it with (fullnode.testnet.sui.io's JSON-RPC route 404s as of 2026-07-08;
# RPC PROVIDER LAW 2026-07-13: publicnode is forbidden — mysten official only —
# so this reads checkpointHeight off the official fullnode's gRPC LedgerService,
# which is confirmed live, instead of a JSON-RPC mirror):
#   grpcurl fullnode.testnet.sui.io:443 sui.rpc.v2.LedgerService/GetServiceInfo
FIRST_CHECKPOINT=
RUST_LOG=info
# Optional allowlist of AresRPG package addresses (canonical 0x… hex, comma-
# separated) the game `ares` + `ares_snapshot` pipelines index — native 0x2::kiosk
# listings are always admitted. EMPTY (default, until the packages publish) matches
# AresRPG events/objects by (module, name); set it once addresses are known to
# harden the cache against a look-alike foreign package.
#
# IMPORTANT — include UPGRADE-LATEST addresses, not just originals. A type/event
# defined in an UPGRADE resolves to the UPGRADED package address, not the original.
# e.g. the aresrpg lineage: `character::Character` keeps the original address, but
# `forgemagie::{CrushBoard,Crushed,BoardCreated}` (added in upgrade #2) resolve to
# `aresrpg.latest` — omit it and the ares_snapshot taux projection is silently
# dropped. Add every lineage's `latest` (ceremony_manifest.json) alongside its `pkg`.
ARES_PACKAGES=

# --- read-api -----------------------------------------------------------------
# Host port the API is published on.
API_PORT=3000
# Per-IP rate limit: at most RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_SEC.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SEC=60
# D52 /v1/names (SuiNS reverse resolution): how long a resolved (or confirmed-nameless) address stays
# cached in Redis before the api re-checks the chain. Names change rarely, so this is hours-scale.
NAMES_CACHE_TTL_SEC=21600
# Per-zkLogin daily sponsor allowance (MIST). The sponsor (api/sponsor.mjs) enforces this cap and INCRBYs
# each player's spend into Redis; /v1/sponsor/remaining reports allowance − spent for the sidebar/modal UX.
# This value feeds BOTH the api and the sponsor service in docker-compose.yml, so one setting keeps the
# displayed allowance equal to the enforced cap. Default 1 SUI ("1 sui/day per player").
SPONSOR_ADDR_DAILY_CAP_MIST=1000000000
# §17.22 gather-ambush resolver served on /v1/config as `protector_templates`: a JSON map of
# seed key → minted protector MobTemplate id, e.g. {"protector_wheat":"0x…"}. Deploy config
# fed from the CEREMONY SEED MANIFEST (the seed step records each minted id) — NOT chain-
# projected: the on-chain MobTemplate carries no role/slug (the seed key is dropped at mint,
# `name` is a display name), so the manifest is the only honest key→id source. EMPTY = {}.
PROTECTOR_TEMPLATES=
# Sentry error reporting for the read-api and indexer log-ship sidecar (errors-only).
# Empty = reporting fully off (dev default). The Rust binary writes marked terminal/panic
# records to an internal structured JSONL volume; the sidecar groups and forwards them.
# The org's DSN is injected at deploy time (k8s SOPS secret) — never commit it here.
SENTRY_DSN=
# Release tag applied by @sentry/node; deploys normally inject the commit SHA.
RELEASE_SHA=dev

# --- gas-pool (opt-in: docker compose --profile gas up) -----------------------
# A FRESH, dedicated, funded testnet sponsor key — NEVER SUI_MASTER_KEY or any
# named production wallet. Generate one: `bun gas-pool/generate-keypair.mjs`.
GAS_POOL_KEYPAIR=
# Bearer token clients present to the gas station.
GAS_STATION_AUTH=
# Host port the gas station is published on.
GAS_POOL_PORT=9527
# NAMED DEBT (RPC PROVIDER LAW 2026-07-13, publicnode forbidden — mysten official only): this default
# looks official but the upstream sui-gas-station binary (github.com/MystenLabs/sui-gas-pool, pinned
# in gas-pool/Dockerfile) wraps sui_sdk::SuiClientBuilder — JSON-RPC ONLY, confirmed via source at
# HEAD (no newer release adds gRPC/GraphQL transport) — and fullnode.testnet.sui.io's JSON-RPC route
# 404s (dead since 2026-07-08). So THIS default is non-functional as written; the actually-running
# local .env/k8s values.yaml override to a JSON-RPC-speaking provider to keep the sponsor alive. Not
# our code's fault — there is currently no official Mysten JSON-RPC endpoint this binary can reach.
# Fix requires either an upstream sui-gas-pool gRPC release or a paid/official Mysten JSON-RPC node.
SUI_FULLNODE_URL=https://fullnode.testnet.sui.io:443
