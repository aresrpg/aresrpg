{
  "name": "@aresrpg/move",
  "version": "1.0.0",
  "description": "Move smart contracts for AresRPG on Sui blockchain",
  "type": "module",
  "private": true,
  "scripts": {
    "publish:testnet": "NETWORK=testnet node -r dotenv/config ./scripts/publish.js",
    "publish:mainnet": "NETWORK=mainnet node -r dotenv/config ./scripts/publish.js",
    "upgrade:testnet": "NETWORK=testnet node -r dotenv/config ./scripts/upgrade.js",
    "upgrade:mainnet": "NETWORK=mainnet node -r dotenv/config ./scripts/upgrade.js",
    "release:prepare": "node ./scripts/release_prepare.mjs",
    "lint": "eslint . && prettier . --check --config ../../.prettierrc",
    "format": "prettier . --write --config ../../.prettierrc && eslint . --fix",
    "freeze": "./scripts/emergency/freeze.sh",
    "status": "./scripts/emergency/status.sh"
  },
  "keywords": [
    "sui",
    "move",
    "blockchain",
    "aresrpg"
  ],
  "author": "AresRPG",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@mysten/prettier-plugin-move": "^0.4.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@types/node": "^24.13.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "@mysten/kiosk": "^1.3.12",
    "@mysten/sui": "^2.23.1"
  },
  "engines": {
    "node": ">=21.0.0"
  }
}
