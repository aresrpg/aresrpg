{
  "name": "@aresrpg/inventory",
  "version": "0.0.0",
  "description": "AresRPG inventory/roster merge core — the ONE `action/sui_data` reducer (XP floor, receipt-over-snapshot, pending buy/consume ledgers) plus the pure fight-receipt roster patch. The game spine folds it; effects and tx wiring live at the frontend edge.",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint . && prettier . --check",
    "typecheck": "tsc --build",
    "format": "prettier . --write && eslint . --fix",
    "test": "bun test"
  },
  "engines": {
    "node": ">=21.0.0"
  },
  "exports": {
    "./reduce": {
      "types": "./types/reduce.d.ts",
      "import": "./src/reduce.js"
    },
    "./consumable_ledger": {
      "types": "./types/consumable_ledger.d.ts",
      "import": "./src/consumable_ledger.js"
    },
    "./bought_items_ledger": {
      "types": "./types/bought_items_ledger.d.ts",
      "import": "./src/bought_items_ledger.js"
    },
    "./fight_receipt_roster": {
      "types": "./types/fight_receipt_roster.d.ts",
      "import": "./src/fight_receipt_roster.js"
    }
  },
  "author": "AresRPG's Team",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@aresrpg/sdk": "workspace:*"
  }
}
