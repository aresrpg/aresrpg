/// Level from total xp — binary search for the highest level whose threshold is <= xp,
/// converging upward onto the floor level. Clamped at MAX_LEVEL, never aborts.
public fun level_from_xp(xp: u64): u16 {
  if (xp == 0) return 1;
  let curve = XP_CURVE; // bind once — avoids re-copying the constant per borrow
  if (xp >= curve[MAX_LEVEL]) return (MAX_LEVEL as u16);
  let mut low = 1;
  let mut high = MAX_LEVEL;
  while (low < high) {
    let mid = (low + high + 1) / 2;
    if (curve[mid] <= xp) { low = mid } else { high = mid - 1 };
  };
  (low as u16)
}

public fun max_level(): u64 { MAX_LEVEL }
