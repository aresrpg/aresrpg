{
  "name": "@aresrpg/sdk",
  "version": "6.0.0",
  "private": true,
  "description": "AresRPG write SDK \u2014 a generated projection of the Move contract (one PTB builder per api.move door) plus a receipt-fed object-version cache",
  "type": "module",
  "exports": {
    ".": "./src/client.ts",
    "./auth": "./src/auth.ts",
    "./doors": "./src/doors.gen.ts",
    "./seed": "./src/seed.ts",
    "./seed-admin": "./src/seed_admin.ts",
    "./seed-doors": "./src/seed_doors.gen.ts",
    "./ptb": "./src/ptb.ts",
    "./cache": "./src/cache.ts",
    "./kolizeum": "./src/kolizeum.ts",
    "./friends": "./src/friends.ts",
    "./party": "./src/party.ts",
    "./trade": "./src/trade.ts",
    "./character": "./src/character.ts",
    "./character-name": "./src/character_name.ts",
    "./character-price": "./src/character_price.ts",
    "./item-snapshot": "./src/item_snapshot.ts",
    "./balance": "./src/balance.ts",
    "./gas-budget": "./src/gas_budget.ts",
    "./marketplace-admin": "./src/marketplace_admin.ts",
    "./marketplace": "./src/marketplace.ts",
    "./stacks": "./src/stacks.ts",
    "./admin-overview": "./src/admin_overview.ts",
    "./deployment-admin": "./src/deployment_admin.ts",
    "./shop": "./src/shop.ts",
    "./sui-transfer": "./src/sui_transfer.ts",
    "./seed-ids": "./src/seed_ids.ts"
  },
  "scripts": {
    "generate": "node scripts/generate_doors.mjs && node scripts/generate_seed_doors.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@aresrpg/immutable": "workspace:*",
    "@aresrpg/protocol": "workspace:*",
    "@mysten/enoki": "^1.2.3",
    "@mysten/kiosk": "1.4.4",
    "@mysten/sui": "2.26.2",
    "@mysten/wallet-standard": "^0.21.5"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "@types/bun": "latest"
  }
}
