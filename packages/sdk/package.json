{
  "name": "@aresrpg/sdk",
  "version": "5.2.27",
  "description": "General SDK to interract with AresRPG",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint . && prettier . --check && bun run typecheck",
    "typecheck": "tsc --build",
    "test": "bun test",
    "generate:forge-catalog": "node scripts/generate_forge_catalog.mjs",
    "format": "prettier . --write && eslint . --fix",
    "postversion": "git push --follow-tags"
  },
  "engines": {
    "node": ">=21.0.0"
  },
  "exports": {
    "./sui": {
      "types": "./types/sui.d.ts",
      "import": "./src/sui.js"
    },
    "./marketplace-pricing": {
      "import": "./src/sui/write/items_marketplace.js"
    },
    "./deployment/items": {
      "types": "./types/deployment/items.d.ts",
      "import": "./src/deployment/items.js"
    },
    "./deployment/aresrpg": {
      "types": "./types/deployment/aresrpg.d.ts",
      "import": "./src/deployment/aresrpg.js"
    },
    "./signer": {
      "types": "./types/signer.d.ts",
      "import": "./src/signer.js"
    },
    "./chunk": {
      "types": "./types/chunk.d.ts",
      "import": "./src/chunk.js"
    },
    "./coords": {
      "types": "./types/coords.d.ts",
      "import": "./src/coords.js"
    },
    "./pending_fight_id": {
      "types": "./types/pending_fight_id.d.ts",
      "import": "./src/pending_fight_id.js"
    },
    "./experience": {
      "types": "./types/experience.d.ts",
      "import": "./src/experience.js"
    },
    "./progression": {
      "types": "./types/progression.d.ts",
      "import": "./src/progression.js"
    },
    "./stats": {
      "types": "./types/stats.d.ts",
      "import": "./src/stats.js"
    },
    "./jobs": {
      "types": "./types/jobs.d.ts",
      "import": "./src/jobs.js"
    },
    "./world-seed": {
      "import": "./src/world_seed.js"
    },
    "./character": {
      "types": "./types/character.d.ts",
      "import": "./src/character.js"
    },
    "./mob-spells": {
      "types": "./types/mob_spells.d.ts",
      "import": "./src/mob_spells.js"
    },
    "./items-data": "./src/items.json",
    "./classes": "./src/classes.json",
    "./mobs": "./src/mobs.json",
    "./mastery": "./src/mastery.json",
    "./zones": "./src/zones.json",
    "./quests": "./src/quests.json",
    "./missing-item-icons": "./src/missing_item_icons.json",
    "./settings": "./src/settings.json",
    "./shops": "./src/shops.json",
    "./npcs": "./src/npcs.json",
    "./chests": "./src/chests.json",
    "./recipes": "./src/recipes.json",
    "./types": "./types.d.ts",
    "./items": {
      "types": "./types/items.d.ts",
      "import": "./src/items.js"
    },
    "./fight": {
      "types": "./types/fight.d.ts",
      "import": "./src/fight.js"
    },
    "./dungeon": {
      "types": "./types/dungeon.d.ts",
      "import": "./src/dungeon.js"
    },
    "./kolizeum": {
      "types": "./types/kolizeum.d.ts",
      "import": "./src/kolizeum.js"
    },
    "./game": {
      "types": "./types/game.d.ts",
      "import": "./src/game.js"
    },
    "./social": {
      "types": "./types/social.d.ts",
      "import": "./src/social.js"
    }
  },
  "keywords": [
    "aresrpg",
    "mmorpg",
    "minecraft"
  ],
  "author": "AresRPG's Team",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "lru-cache": "^11.5.2",
    "spiralloop": "^1.0.2"
  },
  "peerDependencies": {
    "@mysten/kiosk": "^1.3.3",
    "@mysten/sui": "^2.20.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^25.9.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "globals": "^17.8.0",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.64.0"
  }
}
