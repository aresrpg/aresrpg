/// Character level from total xp — binary search for the highest level whose curve threshold is <= xp
/// (mirrors the Java `getLevelFromExperience`'s low/high convergence: `mid = (low+high+1)/2`, converging
/// upward so it lands on the FLOOR level). Clamped at MAX_LEVEL — never aborts on an oversized xp value.
public fun level_from_xp(xp: u64): u64 {
  if (xp == 0) return 1;
  let curve = XP_CURVE; // bind once — avoids re-copying the constant per `.borrow()` call
  if (xp >= *curve.borrow(MAX_LEVEL)) return MAX_LEVEL;
  let mut low = 1;
  let mut high = MAX_LEVEL;
  while (low < high) {
    let mid = (low + high + 1) / 2;
    if (*curve.borrow(mid) <= xp) { low = mid } else { high = mid - 1 };
  };
  low
}

/// Total xp required to REACH `level` (the curve threshold). Used by `progression::xp_add_with_cap_discard` to
/// find the ceiling at the max reachable level. Aborts `EBadLevel` above MAX_LEVEL (level 0 returns 0 harmlessly).
public fun xp_for_level(level: u64): u64 {
  assert!(level <= MAX_LEVEL, EBadLevel);
  let curve = XP_CURVE; // bind once (explicit copy) then borrow the element — avoids the implicit-const-copy path
  *curve.borrow(level)
}

public fun max_level(): u64 { MAX_LEVEL }
