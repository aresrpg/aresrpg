{
  "schema_version": 1,
  "rules": {
    "named_stack": "caster_spell_fighter_key_adds_to_base_before_amplification",
    "punishment": "actual_hp_loss_capped_per_row_creates_independent_timed_bonus",
    "erosion": "live_percentages_sum_and_cap_at_one_hundred",
    "redirect": "zero_is_depth_one_full_sink_positive_rows_sum_as_non_recursive_reflect"
  },
  "cases": [
    {
      "id": "named_stack_repeated_cast_expiry_and_isolation",
      "scenario": "named_stack",
      "input": { "base": 10, "rider": 5, "strength": 100, "turns": 2 },
      "expected": {
        "aimed_hp_after_two": 50,
        "other_hp_after_two": 60,
        "aimed_stack_rows": 2,
        "other_stack_rows": 0,
        "hit_after_expiry": 20,
        "fresh_fight_rows": 0
      }
    },
    {
      "id": "punishment_caps_stats_vitality_expiry_death_and_isolation",
      "scenario": "punishment",
      "input": { "hit": 15 },
      "expected": {
        "health": 85,
        "health_max": 108,
        "strength": 10,
        "percent_damage": 6,
        "bonus_rows": 3,
        "max_after_expiry": 100,
        "killed_bonus_rows": 0,
        "fresh_fight_rows": 0
      }
    },
    {
      "id": "erosion_rows_sum_cap_and_isolate",
      "scenario": "erosion",
      "input": { "hit": 20, "percentages": [30, 80] },
      "expected": { "health": 80, "health_max": 80, "fresh_fight_rows": 0 }
    },
    {
      "id": "redirect_depth_one_reflect_sum_no_recursion_and_isolation",
      "scenario": "redirect",
      "input": { "hit": 20 },
      "expected": {
        "full": {
          "target_hp": 100,
          "guard_hp": 80,
          "guard_max": 100,
          "attacker_hp": 100,
          "triggered_bonus_rows": 0
        },
        "reflect": { "target_hp": 80, "attacker_hp": 90, "reflected": 10 },
        "fresh_fight_rows": 0
      }
    },
    {
      "id": "reaction_kinds_normalize",
      "scenario": "normalize",
      "input": {},
      "expected": {
        "types": ["REACTIVE_PUNISHMENT", "EROSION", "DAMAGE_REDIRECT"],
        "punishment_stat": "percent_damage",
        "trigger_turns": 3
      }
    }
  ]
}
