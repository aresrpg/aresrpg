{
  "rules": {
    "expiry": "Only exact PLACEMENT status at or after placement_deadline_ms with zero ready seats is sweepable.",
    "live_guard": "Before-deadline, any-ready, ACTIVE, and terminal fights are write-free rejections.",
    "settlement": "Sweep auto-abandons every seat, sets all HP to zero, selects DEFEAT with no winner, and uses ordinary settlement."
  },
  "cases": [
    {
      "id": "placement_before_deadline_is_live",
      "input": {
        "status": "PLACEMENT",
        "placement_deadline_ms": 121000,
        "now_ms": 120999,
        "ready_seats": [],
        "hp": [100]
      },
      "expected": {
        "swept": false,
        "status": "PLACEMENT",
        "winner": null,
        "hp": [100],
        "abandoned_seats": [],
        "released_seats": [],
        "outcomes": [],
        "events": []
      }
    },
    {
      "id": "placement_boundary_zero_ready_sweeps_every_seat",
      "input": {
        "status": "PLACEMENT",
        "placement_deadline_ms": 121000,
        "now_ms": 121000,
        "ready_seats": [],
        "hp": [100, 73]
      },
      "expected": {
        "swept": true,
        "status": "DEFEAT",
        "winner": null,
        "hp": [0, 0],
        "abandoned_seats": ["p0", "p1"],
        "released_seats": ["p0", "p1"],
        "outcomes": [
          {
            "seat_id": "p0",
            "outcome": "DEFEAT",
            "final_hp": 0,
            "xp_share": 0,
            "loot": []
          },
          {
            "seat_id": "p1",
            "outcome": "DEFEAT",
            "final_hp": 0,
            "xp_share": 0,
            "loot": []
          }
        ],
        "events": [
          "Abandoned",
          "Abandoned",
          "Defeat",
          "Swept",
          "ResultMinted",
          "ResultMinted",
          "Settled"
        ]
      }
    },
    {
      "id": "placement_expired_with_ready_seat_is_live",
      "input": {
        "status": "PLACEMENT",
        "placement_deadline_ms": 121000,
        "now_ms": 900000,
        "ready_seats": ["p0"],
        "hp": [100]
      },
      "expected": {
        "swept": false,
        "status": "PLACEMENT",
        "winner": null,
        "hp": [100],
        "abandoned_seats": [],
        "released_seats": [],
        "outcomes": [],
        "events": []
      }
    },
    {
      "id": "active_fight_is_never_placement_sweepable",
      "input": {
        "status": "ACTIVE",
        "placement_deadline_ms": 121000,
        "now_ms": 999999999,
        "ready_seats": [],
        "hp": [65, 41]
      },
      "expected": {
        "swept": false,
        "status": "ACTIVE",
        "winner": null,
        "hp": [65, 41],
        "abandoned_seats": [],
        "released_seats": [],
        "outcomes": [],
        "events": []
      }
    },
    {
      "id": "terminal_fight_is_not_sweepable",
      "input": {
        "status": "DEFEAT",
        "placement_deadline_ms": 121000,
        "now_ms": 999999999,
        "ready_seats": [],
        "hp": [0]
      },
      "expected": {
        "swept": false,
        "status": "DEFEAT",
        "winner": null,
        "hp": [0],
        "abandoned_seats": [],
        "released_seats": [],
        "outcomes": [],
        "events": []
      }
    }
  ]
}
