{
  "schema_version": 1,
  "rules": {
    "invisibility_kind": 27,
    "reveal_kind": 28,
    "direct_target": "selected_list_has_fighter_effects_and_all_are_point_shaped",
    "hidden_targeting": "enemy_direct_point_rejected_aoe_resolves_by_cell",
    "damage_reveal": "positive_immediate_cast_or_collision_damage_strips_damager_invisibility_only",
    "indirect_damage": ["trap", "glyph", "dot", "recoil"],
    "all_hidden_ai": "idle_without_last_known_cell"
  },
  "cases": [
    {
      "id": "numeric_invisibility_and_reveal_normalize",
      "scenario": "normalize",
      "input": {
        "effects": [
          { "kind": 27, "turns": 3, "target_filter": 32, "area_shape": 0 },
          {
            "kind": 28,
            "turns": 0,
            "target_filter": 1,
            "area_shape": 1,
            "area_size": 1
          }
        ]
      },
      "expected": { "types": ["INVISIBILITY", "REVEAL"] }
    },
    {
      "id": "reveal_strips_invisibility_only",
      "scenario": "explicit_reveal",
      "input": { "effect_kind": 28, "area_shape": 1, "area_size": 1 },
      "expected": { "target_statuses": ["MP_RIDER", "AP_RIDER"] }
    },
    {
      "id": "direct_point_enemy_rejected_write_free",
      "scenario": "direct_hidden",
      "input": { "effect_kind": 0, "value": 20, "area_shape": 0, "ap_cost": 2 },
      "expected": {
        "error": "INVISIBLE_TARGET",
        "caster_ap": 10,
        "history_rows": 0,
        "state_unchanged": true,
        "target_hp": 100
      }
    },
    {
      "id": "aoe_cell_hits_invisible",
      "scenario": "aoe_hidden",
      "input": {
        "effect_kind": 0,
        "value": 20,
        "area_shape": 1,
        "area_size": 1
      },
      "expected": { "target_hp": 80 }
    },
    {
      "id": "invisible_victim_stays_invisible",
      "scenario": "aoe_hidden",
      "input": {
        "effect_kind": 0,
        "value": 20,
        "area_shape": 1,
        "area_size": 1
      },
      "expected": { "target_statuses": ["INVISIBILITY"] }
    },
    {
      "id": "direct_positive_damage_reveals_damager_only",
      "scenario": "direct_damage",
      "input": { "effect_kind": 0, "value": 20, "area_shape": 0 },
      "expected": { "caster_statuses": ["MP_RIDER"], "target_hp": 80 }
    },
    {
      "id": "zero_damage_keeps_invisibility",
      "scenario": "direct_damage",
      "input": { "effect_kind": 0, "value": 0, "area_shape": 0 },
      "expected": {
        "caster_statuses": ["INVISIBILITY", "MP_RIDER"],
        "target_hp": 100
      }
    },
    {
      "id": "trap_damage_keeps_owner_invisible",
      "scenario": "trap_damage",
      "input": { "effect_kind": 0, "value": 7 },
      "expected": {
        "owner_statuses": ["INVISIBILITY", "MP_RIDER"],
        "target_hp": 93
      }
    },
    {
      "id": "direct_push_collision_reveals",
      "scenario": "push_collision",
      "input": {
        "effect_kind": 12,
        "value": 2,
        "area_shape": 0,
        "caster_level": 50
      },
      "expected": { "caster_statuses": ["MP_RIDER"], "target_hp": 76 }
    },
    {
      "id": "mob_skips_invisible_target",
      "scenario": "mob_targeting",
      "input": { "hidden_target": "p0", "visible_target": "p1" },
      "expected": { "cast_target": 50 }
    },
    {
      "id": "all_targets_invisible_mob_idles_and_ticks",
      "scenario": "all_hidden",
      "input": { "hidden_turns": 1 },
      "expected": {
        "next_actor": "p0",
        "hidden_remaining": true,
        "mob_moved": false,
        "mob_cast": false
      }
    },
    {
      "id": "vanish_persistent_invisible_wave_still_advances_④",
      "scenario": "all_hidden",
      "input": { "hidden_turns": 3 },
      "expected": {
        "next_actor": "p0",
        "hidden_remaining": true,
        "mob_moved": false,
        "mob_cast": false
      }
    },
    {
      "id": "mob_direct_damage_reveals",
      "scenario": "mob_damage",
      "input": { "effect_kind": 0, "value": 20, "area_shape": 0 },
      "expected": { "mob_statuses": [], "target_hp": 80 }
    }
  ]
}
