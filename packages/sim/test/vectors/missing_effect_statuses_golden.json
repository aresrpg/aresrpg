{
  "schema_version": 1,
  "rules": {
    "damage_to_heal": "per_hit_chance_selects_heal_multiplier_or_damage_multiplier",
    "forced_death": "bypasses_reduction_except_full_health_immunity",
    "timed_payload": "stat_counts_following_effects_and_turns_is_bearer_start_delay",
    "stance": "negative_row_clears_and_every_end_emits_presentation_event"
  },
  "cases": [
    {
      "id": "damage_to_heal_success_and_failure",
      "scenario": "damage_to_heal",
      "input": {
        "health": 50,
        "incoming": 10,
        "damage_multiplier": 2,
        "heal_multiplier": 3
      },
      "expected": {
        "success": { "health": 80, "damage": 0, "heal": 30 },
        "failure": { "health": 30, "damage": 20, "heal": 0 }
      }
    },
    {
      "id": "damage_to_heal_applies_to_turn_start_dot",
      "scenario": "dot_inversion",
      "input": { "health": 40, "tick": 12, "heal_multiplier": 2 },
      "expected": { "health": 64, "event_heal": 24, "damage_rows": 0 }
    },
    {
      "id": "forced_death_only_full_immunity_survives",
      "scenario": "forced_death",
      "input": { "health": 60, "health_max": 100 },
      "expected": {
        "partial_shield": { "health": 0, "status": "FORCED_DEATH" },
        "full_shield": { "health": 60, "status": "FORCED_DEATH_IMMUNE" },
        "pool_shield": { "health": 0, "status": "FORCED_DEATH" }
      }
    },
    {
      "id": "timed_payload_normalizer_consumes_exact_link_count",
      "scenario": "timed_normalize",
      "input": { "linked_count": 2, "delay": 2 },
      "expected": {
        "types": ["TIMED_PAYLOAD", "DAMAGE"],
        "payload_types": ["DAMAGE", "HEAL"]
      }
    },
    {
      "id": "timed_payload_fires_on_second_bearer_start",
      "scenario": "timed_turn_start",
      "input": { "delay": 2, "damage": 10 },
      "expected": {
        "after_first_start": { "health": 100, "remaining": 1 },
        "after_second_start": {
          "health": 90,
          "remaining": 0,
          "event_damage": 10
        }
      }
    },
    {
      "id": "stance_apply_clear_expire_and_fight_isolation",
      "scenario": "stance_lifecycle",
      "input": { "stance": 42 },
      "expected": {
        "applied_rows": 1,
        "apply_event": "STANCE",
        "cleared_rows": 0,
        "clear_event": "STANCE_END",
        "expiry_event": "STANCE_END",
        "fresh_fight_rows": 0
      }
    }
  ]
}
