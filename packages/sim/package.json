  "private": true,
  "scripts": {
    "lint": "eslint . && prettier . --check && bun run typecheck",
    "typecheck": "tsc --build",
    "format": "prettier . --write && eslint . --fix",
    "test": "bun test"
  },
  "engines": {
    "node": ">=21.0.0"
  },
  "exports": {
    "./prng": {
      "types": "./types/prng.d.ts",
