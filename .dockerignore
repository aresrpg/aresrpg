# Shared build context for the realtime and Discord Dockerfiles.
# The indexer builds from its own directory. Deny everything, then admit the workspace
# manifests and the two separately selected runtime dependency closures.
# A path ladder is required because a "!" exception cannot re-admit a file whose parent
# directory is still excluded.
*
!package.json
!bun.lock
!patches
!patches/**
!packages
packages/*
!packages/bot
packages/bot/*
!packages/bot/package.json
!packages/engine
packages/engine/*
!packages/engine/package.json
!packages/engine/src
!packages/fight
packages/fight/*
!packages/fight/package.json
!packages/fight/src
!packages/ui
packages/ui/*
!packages/ui/package.json
!packages/ui/src
!packages/frontend
packages/frontend/*
!packages/frontend/package.json
!packages/frontend/src
packages/frontend/src/*
!packages/frontend/src/i18n
packages/frontend/src/i18n/*
!packages/frontend/src/i18n/locales
!packages/mobile
packages/mobile/*
!packages/mobile/package.json
!packages/journal
packages/journal/*
!packages/journal/package.json
!packages/immutable
packages/immutable/*
!packages/immutable/package.json
!packages/immutable/src
!packages/protocol
packages/protocol/*
!packages/protocol/package.json
!packages/protocol/src
!packages/sdk
packages/sdk/*
!packages/sdk/package.json
!packages/sdk/src
packages/sdk/src/*
!packages/sdk/src/agent_pairing.ts
!packages/sdk/src/agent_multisig.ts
!packages/discord
packages/discord/*
!packages/discord/package.json
!packages/discord/src
!packages/server
packages/server/*
!packages/server/package.json
!packages/server/src

!seed
seed/*
!seed/content
!seed/structures
!seed/icons
seed/icons/*
!seed/icons/items
seed/icons/items/*_hd.*
!seed/icons/mobs
seed/icons/mobs/*_hd.*

# Public campaign card artwork only; other journal/currency assets stay outside these images.
!seed/icons/currency
seed/icons/currency/*
!seed/icons/currency/kares.png

!packages/frontend/public
packages/frontend/public/*
!packages/frontend/public/branding
packages/frontend/public/branding/*
!packages/frontend/public/branding/helmet-favicon.png
!packages/frontend/public/branding/kares
packages/frontend/public/branding/kares/*
!packages/frontend/public/branding/kares/*.webp

# Never, whatever the ladder above re-admits.
**/node_modules
node_modules
